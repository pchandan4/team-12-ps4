# DeskBot - AI-Powered IT Helpdesk Ticket Agent (PS4)
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to GitHub.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Mandatory Gemini model for hackathon
GEMINI_MODEL=gemini-3.8-flash

# Supabase -> Project Settings -> Project URL
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> secret key (service_role)
# Server only. Never use this in frontend code.
SUPABASE_SECRET_KEY=

# Your team passcode to protect the app and Gemini API quota
APP_PASSCODE=srm123

# Administrator passcode for IT Admin Board triage and updates
ADMIN_PASSCODE=admin123
